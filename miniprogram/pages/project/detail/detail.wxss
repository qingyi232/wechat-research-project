.detail-title { font-size: 36rpx; font-weight: 700; display: block; }
.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
}
.info-label { color: #999; }
.desc-text { font-size: 28rpx; color: #666; line-height: 1.8; display: block; margin-top: 12rpx; }
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 32rpx;
  display: flex;
  gap: 16rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.06);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
.action-bar button { flex: 1; margin: 0; }
.btn-reject {
  background: #e74c3c;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  border: none;
}
.btn-reject::after { border: none; }
