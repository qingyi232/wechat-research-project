.notice-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  position: relative;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.notice-item.unread { border-left: 6rpx solid #2d8f7b; }
.notice-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e8f5f0, #d3ebe4);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.notice-icon { width: 40rpx; height: 40rpx; }
.notice-content { flex: 1; min-width: 0; }
.notice-dot {
  width: 14rpx;
  height: 14rpx;
  background: #e74c3c;
  border-radius: 50%;
  position: absolute;
  top: 28rpx;
  right: 24rpx;
}
.notice-title { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.notice-text { font-size: 26rpx; color: #666; line-height: 1.6; margin-bottom: 8rpx; }
.notice-time { font-size: 22rpx; color: #999; }

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-icon { width: 200rpx; height: 200rpx; margin-bottom: 24rpx; }
.empty-state .empty-text {
  font-size: 28rpx;
  color: #999;
}
