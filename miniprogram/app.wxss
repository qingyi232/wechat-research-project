page {
  background: #f5f7f6;
  font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #2c3e50;
  font-size: 28rpx;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.btn-primary {
  background: #2d8f7b;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  border: none;
}

.btn-primary::after {
  border: none;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.tag-success { background: #e8f5f0; color: #2d8f7b; }
.tag-warning { background: #fef5e7; color: #e8a838; }
.tag-danger { background: #fde8e8; color: #e74c3c; }
.tag-info { background: #eef2f5; color: #7f8c8d; }

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #2c3e50;
}

.empty-text {
  text-align: center;
  color: #999;
  padding: 60rpx 0;
  font-size: 28rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-state .empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
  opacity: 0.85;
}
.empty-state .empty-text {
  padding: 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

/* ===== SVG Icon System (using local SVG files via image component) ===== */
.svg-icon {
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  vertical-align: middle;
  flex-shrink: 0;
}
.svg-icon-sm { width: 32rpx; height: 32rpx; }
.svg-icon-lg { width: 48rpx; height: 48rpx; }
.svg-icon-xl { width: 64rpx; height: 64rpx; }
.svg-icon-2x { width: 80rpx; height: 80rpx; }
.svg-icon-3x { width: 100rpx; height: 100rpx; }

/* ===== Global Input/Form Hardening (\u9632\u6b62\u8f93\u5165\u6846\u8fc7\u7a84\u622a\u65ad\u6587\u5b57) ===== */
input, textarea {
  box-sizing: border-box;
  line-height: 1.5;
}
.placeholder-style { color: #b0b6bc; font-size: 28rpx; }

.list-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.list-item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.list-item-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #999;
  font-size: 24rpx;
}
