.register-page { min-height: 100vh; background: linear-gradient(180deg, #2d8f7b 0%, #f5f7f6 40%); padding: 60rpx 40rpx 40rpx; box-sizing: border-box; }
.register-header { text-align: center; padding: 40rpx 0 50rpx; }
.logo-circle { width: 110rpx; height: 110rpx; border-radius: 50%; background: #ffffff; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 20rpx; box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.12); }
.logo-icon { width: 60rpx; height: 60rpx; }
.form-icon { width: 36rpx; height: 36rpx; margin-right: 16rpx; }
.app-title { display: block; color: #fff; font-size: 36rpx; font-weight: 600; margin-bottom: 8rpx; }
.app-subtitle { display: block; color: rgba(255,255,255,0.7); font-size: 24rpx; }
.register-form { background: #fff; border-radius: 20rpx; padding: 40rpx; box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.08); }
.form-item { display: flex; align-items: center; border-bottom: 1rpx solid #f0f2f5; padding: 28rpx 0; min-height: 96rpx; box-sizing: border-box; }
.form-input { flex: 1; font-size: 28rpx; color: #333; height: 60rpx; line-height: 60rpx; }
.picker-text { color: #333; line-height: 60rpx; height: 60rpx; }
.register-btn { width: 100%; background: #2d8f7b; color: #fff; border: none; border-radius: 12rpx; font-size: 30rpx; padding: 22rpx 0; margin-top: 40rpx; }
.register-btn::after { border: none; }
.login-link { text-align: center; margin-top: 30rpx; color: #2d8f7b; font-size: 26rpx; }
