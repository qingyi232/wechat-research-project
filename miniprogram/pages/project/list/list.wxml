<view class="container">
  <view class="search-bar">
    <image class="search-icon" src="/images/icon-search.svg" mode="aspectFit" />
    <input class="search-input" placeholder="搜索项目名称" bindinput="onSearch" />
  </view>

  <view class="tab-bar">
    <view class="tab-item {{currentTab === '' ? 'active' : ''}}" bindtap="switchTab" data-tab="">全部</view>
    <view class="tab-item {{currentTab === 'HORIZONTAL' ? 'active' : ''}}" bindtap="switchTab" data-tab="HORIZONTAL">横向</view>
    <view class="tab-item {{currentTab === 'VERTICAL' ? 'active' : ''}}" bindtap="switchTab" data-tab="VERTICAL">纵向</view>
  </view>

  <view class="list-item" wx:for="{{projects}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
    <view class="list-item-title">{{item.projectName}}</view>
    <view class="list-item-info">
      <text>{{item.leaderName}} · {{item.collegeName || ''}}</text>
      <view class="tag {{statusClass[item.status]}}">{{statusMap[item.status]}}</view>
    </view>
    <view class="list-item-info" style="margin-top:8rpx">
      <text>经费: {{item.fundingAmount || 0}}万</text>
      <text>{{item.applyDate || ''}}</text>
    </view>
  </view>

  <view class="empty-state" wx:if="{{projects.length === 0 && !loading}}">
    <image class="empty-icon" src="/images/icon-empty.svg" mode="aspectFit" />
    <text class="empty-text">暂无项目数据</text>
  </view>

  <view class="add-btn" wx:if="{{userInfo.role === 'TEACHER'}}" bindtap="goApply">
    <image class="add-icon" src="/images/icon-plus.svg" mode="aspectFit" />
    <text>申报项目</text>
  </view>
</view>
