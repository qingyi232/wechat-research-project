.container { padding: 24rpx; }
.page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.page-title { font-size: 36rpx; font-weight: 600; color: #2c3e50; }
.add-btn { background: #2d8f7b; color: #fff; font-size: 28rpx; padding: 12rpx 28rpx; border-radius: 8rpx; display: flex; align-items: center; gap: 8rpx; box-shadow: 0 4rpx 12rpx rgba(45,143,123,0.3); }
.add-icon { width: 28rpx; height: 28rpx; }
.form-panel { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.form-title { font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; color: #2c3e50; }
.form-item { margin-bottom: 24rpx; }
.form-item.half { flex: 1; }
.form-label { font-size: 26rpx; color: #666; margin-bottom: 10rpx; display: block; }
.form-item input, .form-item textarea { background: #f5f7f6; border-radius: 10rpx; padding: 24rpx 20rpx; font-size: 28rpx; width: 100%; box-sizing: border-box; min-height: 84rpx; line-height: 1.5; }
.form-item textarea { min-height: 160rpx; height: auto; padding: 20rpx; line-height: 1.6; }
.picker-value { background: #f5f7f6; border-radius: 10rpx; padding: 24rpx 20rpx; font-size: 28rpx; color: #333; min-height: 84rpx; box-sizing: border-box; display: flex; align-items: center; }
.form-row { display: flex; gap: 20rpx; }
.form-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.btn-cancel { flex: 1; text-align: center; padding: 18rpx; background: #eee; border-radius: 8rpx; font-size: 28rpx; color: #666; }
.btn-submit { flex: 1; text-align: center; padding: 18rpx; background: #2d8f7b; border-radius: 8rpx; font-size: 28rpx; color: #fff; }
.list-section { }
.empty-tip { text-align: center; padding: 80rpx 0; color: #999; font-size: 28rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16rpx; }
.card-title { font-size: 30rpx; font-weight: 500; color: #2c3e50; flex: 1; margin-right: 16rpx; }
.tag { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 6rpx; white-space: nowrap; }
.tag-success { background: #eafaf1; color: #27ae60; }
.tag-primary { background: #ebf5fb; color: #3498db; }
.tag-warning { background: #fef5e7; color: #e8a838; }
.tag-danger { background: #fdedec; color: #e74c3c; }
.tag-info { background: #f0f2f5; color: #999; }
.card-info { display: flex; gap: 24rpx; }
.info-item { font-size: 26rpx; color: #666; }
.card-detail { display: flex; gap: 12rpx; margin-top: 12rpx; flex-wrap: wrap; }
.detail-item { font-size: 24rpx; color: #888; background: #f5f7f6; padding: 4rpx 12rpx; border-radius: 4rpx; }
.action-bar { display: flex; gap: 16rpx; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #e8ece9; }
.btn-action { flex: 1; text-align: center; padding: 14rpx 0; border-radius: 8rpx; font-size: 26rpx; }
.btn-approve { background: #2d8f7b; color: #fff; }
.btn-reject { background: #e74c3c; color: #fff; }
