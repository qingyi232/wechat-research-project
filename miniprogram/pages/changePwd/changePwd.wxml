<view class="container">
  <view class="page-header">
    <text class="page-title">修改密码</text>
  </view>

  <view class="form-panel">
    <view class="form-item">
      <text class="form-label">原密码</text>
      <input type="text" password placeholder="请输入原密码" data-field="oldPassword" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">新密码</text>
      <input type="text" password placeholder="请输入新密码（至少6位）" data-field="newPassword" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">确认密码</text>
      <input type="text" password placeholder="请再次输入新密码" data-field="confirmPassword" bindinput="onInput" />
    </view>
    <view class="form-actions">
      <view class="btn-submit {{loading ? 'btn-disabled' : ''}}" bindtap="submit">
        {{loading ? '提交中...' : '确认修改'}}
      </view>
    </view>
  </view>
</view>
